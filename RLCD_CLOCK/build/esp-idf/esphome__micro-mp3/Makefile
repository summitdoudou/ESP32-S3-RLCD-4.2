	cd /opt/data/cache/rlcd_build/rlcd/RLCD_CLOCK/build && $(MAKE) $(MAKESILENT) -f esp-idf/esphome__micro-mp3/CMakeFiles/__idf_esphome__micro-mp3.dir/build.make esp-idf/esphome__micro-mp3/CMakeFiles/__idf_esphome__micro-mp3.dir/src/opencore-mp3dec/pvmp3_tables.cpp.i
.PHONY : src/opencore-mp3dec/pvmp3_tables.cpp.i

src/opencore-mp3dec/pvmp3_tables.s: src/opencore-mp3dec/pvmp3_tables.cpp.s
.PHONY : src/opencore-mp3dec/pvmp3_tables.s

# target to generate assembly for a file
