	@echo "... display_bsp.i"
	@echo "... display_bsp.s"
	@echo "... i2c_bsp.obj"
	@echo "... i2c_bsp.i"
	@echo "... i2c_bsp.s"
	@echo "... i2c_equipment.obj"
	@echo "... i2c_equipment.i"
	@echo "... i2c_equipment.s"
.PHONY : help



#=============================================================================
# Special targets to cleanup operation of make.

# Special rule to run CMake to check the build system integrity.
# No rule that depends on this can have commands that come from listfiles
# because they might be regenerated.
cmake_check_build_system:
	cd /opt/data/cache/rlcd_build/rlcd/RLCD_CLOCK/build && $(CMAKE_COMMAND) -S$(CMAKE_SOURCE_DIR) -B$(CMAKE_BINARY_DIR) --check-build-system CMakeFiles/Makefile.cmake 0
.PHONY : cmake_check_build_system

